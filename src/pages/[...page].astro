---
import type { GetStaticPaths } from 'astro'
import { themeConfig } from '~/.config'
import Pagination from '~/components/Pagination.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import LayoutPost from '~/layouts/LayoutPost.astro'
import { getPostDescription, getPosts } from '~/utils'

const { translate: t } = Astro.locals

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })
  return paginate(posts, { pageSize: themeConfig.site.pageSize })
}) satisfies GetStaticPaths

interface Memo {
  name: string
  content: string
  createTime: string
}

async function fetchLatestMemos(limit: number = 10): Promise<Memo[]> {
  try {
    const controller = new AbortController()
    const timeoutId = setTimeout(() => controller.abort(), 5000)

    const response = await fetch(`https://memos.ficor.net/api/v1/memos?pageSize=${limit}`, {
      headers: {
        Accept: 'application/json',
      },
      signal: controller.signal,
    })

    clearTimeout(timeoutId)

    if (!response.ok) return []

    const data = await response.json()
    return data.memos || []
  } catch (error) {
    return []
  }
}

function formatShortTime(timeStr: string): string {
  const date = new Date(timeStr)
  const now = new Date()
  const diffMs = now.getTime() - date.getTime()
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24))

  if (diffDays === 0) {
    return date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
  } else if (diffDays === 1) {
    return '昨天'
  } else if (diffDays < 7) {
    return `${diffDays}天前`
  }
  return date.toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' })
}

function truncateContent(content: string, maxLen: number = 50): string {
  const cleanContent = content.replace(/https?:\/\/[^\s]+/g, '')
  if (cleanContent.length <= maxLen) return cleanContent
  return cleanContent.slice(0, maxLen) + '...'
}

const memos = await fetchLatestMemos(1)
const { page } = Astro.props
---

<LayoutDefault>
  <section contain-layout flex="~ col gap-7.5">
    <div class="prose">
      {
        memos.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center mb-3 !m-0">
              <span class="i-mdi-forum-outline w-5 h-5 mr-2 text-primary" />
              <h3 class="font-bold text-sm !m-0">碎碎念</h3>
            </div>
            {memos.map((memo) => (
              <a
                href="/say"
                class="group block not-underline-hover duration-800 ease-in-out px-4 py-3 border-0 no-underline hover:no-underline"
                hover:bg-primary
              >
                <div class="flex items-center mb-2">
                  <span class="i-mdi-clock-outline w-3 h-3 mr-1 text-gray-400 group-hover:text-white" />
                  <span class="text-xs text-gray-500 dark:text-gray-400 group-hover:text-white">
                    {formatShortTime(memo.createTime)}
                  </span>
                </div>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed group-hover:text-white !m-0">
                  {truncateContent(memo.content, 150)}
                </p>
              </a>
            ))}
          </div>
        )
      }
      {
        page.data.map((post, index) => (
          <>
            {memos.length > 0 && index === 0 && <div class="mb-6 h-px w-full bg-gray-400 dark:bg-gray-500" />}
            <LayoutPost post={post}>
              <p class="line-clamp-4">{getPostDescription(post)}</p>
            </LayoutPost>
          </>
        ))
      }
    </div>
    <Pagination
      showLeft={Boolean(page.url.prev)}
      leftTitle={t('prev')}
      leftUrl={page.url.prev}
      showRight={Boolean(page.url.next)}
      rightTitle={t('next')}
      rightUrl={page.url.next}
      currentPage={page.currentPage}
      totalPage={page.lastPage}
    />
  </section>
</LayoutDefault>

---
import LayoutDefault from '~/layouts/LayoutDefault.astro'

interface FeedItem {
  id?: number
  title: string
  link: string
  description: string
  summary?: string
  date: string
  timestamp?: number
  source_title?: string
  domain?: string
  siteName?: string
}

const API_URLS = [
  'https://jh.3v.hk/api.php?action=get_all_items&uid=16&token=741afb1d210656544af0490d0824ca6e&li',
  'https://lilog.cn/is/index.php?action=get_user_feeds&uid=54008&limit=30&token=2bd4eea157becfd45baf299494394392',
]

function extractDomain(url: string): string {
  try {
    const { hostname } = new URL(url)
    return hostname
  } catch {
    return ''
  }
}

function getSiteName(domain: string, sourceTitle: string): string {
  const domainNames: Record<string, string> = {
    'blog.veitzn.top': '维兹南的博客',
    'veitzn.top': '维兹南',
    'iliu.org': '老刘博客',
    'acevs.com': 'ACEVS',
    'ygz.ink': '宗宗酱',
    'lilog.cn': 'LiLog',
    'jh.3v.hk': '聚合API',
    'ficor.net': '荒野菲克',
    'blog.ficor.net': '静·夜·思',
    'zhujay.com': '朱小呆',
  }

  if (sourceTitle && !['聚合API', 'Lilog'].includes(sourceTitle)) {
    return sourceTitle
  }

  return domainNames[domain] || domain.replace('www.', '').split('.')[0] || '博客'
}

async function fetchFeeds(): Promise<FeedItem[]> {
  try {
    const controller = new AbortController()
    const timeoutId = setTimeout(() => controller.abort(), 10000)

    const results = await Promise.allSettled(
      API_URLS.map(async (url) => {
        const response = await fetch(url, {
          headers: {
            Accept: 'application/json',
            'Cache-Control': 'no-cache',
          },
          signal: controller.signal,
        })
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        return response.json()
      }),
    )

    clearTimeout(timeoutId)

    const allItems: FeedItem[] = []

    results.forEach((result) => {
      if (result.status === 'fulfilled') {
        const data = result.value
        const items = data?.data || []

        items.forEach((item: any) => {
          const domain = extractDomain(item.link)
          const siteName = getSiteName(domain, item.source_title)

          allItems.push({
            id: item.id,
            title: item.title || '无标题',
            link: item.link || '#',
            description: item.description || item.summary || '',
            summary: item.summary,
            date:
              item.date ||
              (item.timestamp
                ? new Date(item.timestamp * 1000).toLocaleDateString('zh-CN')
                : new Date().toLocaleDateString('zh-CN')),
            timestamp: item.timestamp,
            source_title: item.source_title || item.nickname || siteName,
            siteName,
            domain,
          })
        })
      }
    })

    const seen = new Set<string>()
    const uniqueItems: FeedItem[] = []

    for (const item of allItems) {
      const key = item.link || `${item.title}-${item.siteName}`
      if (!seen.has(key)) {
        seen.add(key)
        uniqueItems.push(item)
      }
    }

    return uniqueItems.sort((a, b) => {
      const tsA = a.timestamp || new Date(a.date).getTime() / 1000
      const tsB = b.timestamp || new Date(b.date).getTime() / 1000
      return tsB - tsA
    })
  } catch (error) {
    console.error('Error fetching feeds:', error)
    return []
  }
}

const feedItems = await fetchFeeds()
---

<LayoutDefault>
  <section>
    <div class="flex items-center justify-between mb-6">
      <h1 class="post-title !mb-0">友圈动态</h1>
      <span class="text-sm text-gray-500 dark:text-gray-400">
        共 <span class="text-primary font-bold">{feedItems.length}</span> 篇更新
      </span>
    </div>

    <div class="space-y-6">
      <div class="p-4 rounded-lg border border-gray-100 dark:border-gray-800">
        <div class="flex items-center mb-2">
          <span class="i-mdi-rss-box mr-2 w-6 h-6"></span>
          <h3 class="font-bold">博友最新文章</h3>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          实时聚合来自独立博客圈的最新文章，与志同道合的博友一起交流进步 ✨
        </p>
      </div>

      <div class="space-y-3">
        {
          feedItems.length > 0 ? (
            feedItems.map((item, index) => (
              <article class="group p-4 rounded-lg border border-gray-100 dark:border-gray-800 hover:border-blue-200 dark:hover:border-blue-700 hover:bg-blue-50/30 dark:hover:bg-blue-900/10 transition-all duration-300">
                <div class="flex items-start gap-3">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-2 flex-wrap">
                      <span class="font-medium text-sm text-gray-700 dark:text-gray-300">
                        {item.siteName || item.source_title}
                      </span>
                      <span class="text-xs text-gray-400">·</span>
                      <time class="text-xs text-gray-400">{item.date}</time>
                      {index < 3 && (
                        <span class="px-2 py-0.5 text-xs rounded-full bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400 font-medium">
                          NEW
                        </span>
                      )}
                    </div>
                    <h4 class="font-semibold text-base mb-2">
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="not-underline-hover duration-800 ease-in-out px-2 py-1"
                        hover:bg-primary
                        hover:color-background
                      >
                        {item.title}
                      </a>
                    </h4>
                    {item.description && (
                      <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
                        {item.description
                          .replace(/<[^>]*>/g, '')
                          .slice(0, 150)
                          .trim()}
                        {item.description.length > 150 ? '...' : ''}
                      </p>
                    )}
                  </div>
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                  >
                    <span class="i-mdi-arrow-top-right w-5 h-5 text-blue-500" />
                  </a>
                </div>
              </article>
            ))
          ) : (
            <div class="p-8 rounded-lg border border-gray-200 dark:border-gray-700 text-center">
              <span class="i-mdi-coffee-outline w-12 h-12 mx-auto mb-3 text-gray-400" />
              <p class="text-gray-500 dark:text-gray-400">正在获取友圈动态...</p>
              <p class="text-sm text-gray-400 mt-1">如果持续不显示，请检查网络连接</p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</LayoutDefault>
